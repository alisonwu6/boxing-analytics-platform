// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  passwordHash   String
  createdAt      DateTime        @default(now())
  uploadSessions UploadSession[]
}

model UploadSession {
  id               String    @id @default(uuid())
  userId           String
  title            String    @default("Boxing Session Upload")
  sessionType      String    @default("training")
  sessionDate      DateTime  @default(now())
  sessionStartAt   DateTime?
  sessionEndAt     DateTime?
  csvKey           String?
  movKey           String?
  csvUploadStatus  String    @default("missing")
  movUploadStatus  String    @default("missing")
  status           String    @default("draft")
  processingStatus String    @default("idle")
  csvFileData      String?
  movFileData      String?
  resultsData      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
