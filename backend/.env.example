PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boxing-analytics
DB_USER=postgres
DB_PASSWORD=yourpassword
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/boxing-analytics

# Auth
JWT_SECRET=your-jwt-secret

# Storage
UPLOAD_PROVIDER=s3
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=boxing-analytics-upload-files
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=your-aws-session-token

# ML inference
PYTHON_BIN=your-python-bin-path
FFMPEG_BIN=your-ffmpeg-bin-path
ML_INFERENCE_SCRIPT=../ml/run_inference.py
ML_INFERENCE_TIMEOUT_MS=5400000
