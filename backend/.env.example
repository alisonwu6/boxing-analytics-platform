PORT=3001

# Database (pg style — used by some local setups)
PGHOST=localhost
PGPORT=5432
PGDATABASE=boxing-analytics
PGUSER=postgres
PGPASSWORD=yourpassword

# Managed by AWS SSM in production (/boxing-analytics/...)
# Set these locally only. ECS pulls them from SSM automatically.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boxing-analytics
DB_USER=postgres
DB_PASSWORD=yourpassword
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/boxing-analytics
JWT_SECRET=your-jwt-secret
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=boxing-analytics-upload-files
CORS_ORIGIN=http://localhost:5173
UPLOAD_PROVIDER=s3

# AWS credentials — local dev only (ECS uses IAM role, not keys)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=your-aws-session-token

# Set in ECS task definition as plain env vars
ML_INFERENCE_TIMEOUT_MS=900000
ML_INFERENCE_SCRIPT=

VIDEO_POSE_MODEL=mediapipe
VIDEO_MODEL_PATH=
VIDEO_ANALYSIS_DURATION_SECS=
VIDEO_OFFSET_R=
VIDEO_SYNC_JUMP_WINDOW=

# Docker only — leave empty, python3 and ffmpeg are on PATH in the image ─────
PYTHON_BIN=
FFMPEG_BIN=
